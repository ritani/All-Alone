{
  "name": "all-alone",
  "version": "0.1.0",
  "private": true,
  "description": "ALL ALONE: a survival-horror game of a lock house, a river and the Stillness.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:core": "node scripts/build-core.mjs",
    "dev": "npm run build:core && vite",
    "build": "npm run build:core && vite build",
    "build:mobile": "npm run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "icons": "node scripts/icons.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "types": "cd crates/core && UPDATE_TYPES=1 cargo test --features ts --lib ts_types",
    "check:rust": "cargo fmt --all --check && cargo clippy --all-targets --all-features -- -D warnings && cargo test && cargo test --features ts --lib ts_types",
    "check": "npm run check:rust && npm run build:core && npm run typecheck && npm run lint && npm run test && vite build",
    "audit:rust": "cargo audit",
    "audit": "npm audit --audit-level=low && cargo audit"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.7",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/status-bar": "8.0.4",
    "preact": "11.2.0"
  }
}
