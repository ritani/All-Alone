# Security headers for static hosts that read _headers (Netlify, Cloudflare Pages).
# Keep in step with index.html (same CSP, minus frame-ancestors, which a meta tag
# cannot carry) and vercel.json; the build fails if the CSPs differ.
#
# HSTS: serve over HTTPS only. Most hosts add Strict-Transport-Security on their
# own domains; on a custom domain add
#   Strict-Transport-Security: max-age=63072000; includeSubDomains
# once HTTPS is confirmed for every subdomain (add "; preload" only deliberately).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), web-share=(), xr-spatial-tracking=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Origin-Agent-Cluster: ?1

# The service worker must always be revalidated so new builds are picked up.
/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
