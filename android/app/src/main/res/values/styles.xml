<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: dark, so nothing flashes white before the page draws. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/field</item>
        <item name="colorPrimaryDark">@color/field</item>
        <item name="colorAccent">@color/line</item>
        <item name="android:windowBackground">@color/field</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/field</item>
    </style>

    <!-- Launch: the mark on the field (Android 12+ system splash; the
         drawable/splash images before that). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/field</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
